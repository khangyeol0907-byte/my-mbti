```html
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MBTI로 포켓몬 찾기</title>
<style>
  :root {
    --cream: #FFF8E1;
    --cream-deep: #FFECB3;
    --yellow: #FFD54F;
    --yellow-deep: #FFB300;
    --brown: #6D4C22;
    --brown-soft: #8D6E3A;
    --white: #FFFFFF;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 100%);
    font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--brown);
    display: flex;
    justify-content: center;
    padding: 24px 16px 60px;
  }

  .wrap {
    width: 100%;
    max-width: 720px;
  }

  header {
    text-align: center;
    margin-bottom: 28px;
  }

  header h1 {
    font-size: 2.1rem;
    margin: 0 0 8px;
    color: var(--brown);
  }

  header p {
    font-size: 1.15rem;
    color: var(--brown-soft);
    margin: 0;
  }

  .card-panel {
    background: var(--white);
    border-radius: 24px;
    padding: 28px 22px;
    box-shadow: 0 8px 24px rgba(160, 120, 40, 0.15);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  @media (max-width: 480px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    header h1 { font-size: 1.7rem; }
  }

  .mbti-btn {
    background: var(--yellow);
    border: none;
    border-radius: 16px;
    padding: 18px 8px;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--brown);
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .mbti-btn:hover {
    background: var(--yellow-deep);
    transform: translateY(-3px) scale(1.04);
  }

  .mbti-btn:active {
    transform: scale(0.97);
  }

  .instruction {
    text-align: center;
    font-size: 1.1rem;
    margin-bottom: 18px;
    color: var(--brown-soft);
  }

  .hidden { display: none; }

  .result {
    text-align: center;
  }

  .result .type-tag {
    display: inline-block;
    background: var(--cream-deep);
    color: var(--brown);
    font-weight: 800;
    font-size: 1.1rem;
    padding: 6px 18px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .emoji-big {
    font-size: 6.5rem;
    line-height: 1.1;
    margin: 6px 0 10px;
  }

  .poke-name {
    font-size: 2rem;
    font-weight: 900;
    margin: 0 0 14px;
    color: var(--brown);
  }

  .reason-box {
    background: var(--cream);
    border-radius: 18px;
    padding: 18px 20px;
    font-size: 1.15rem;
    line-height: 1.65;
    text-align: left;
    margin: 0 auto 20px;
    max-width: 520px;
    color: var(--brown);
  }

  .match-box {
    background: linear-gradient(135deg, var(--yellow) 0%, var(--yellow-deep) 100%);
    border-radius: 18px;
    padding: 16px 20px;
    max-width: 520px;
    margin: 0 auto 24px;
    font-size: 1.1rem;
    color: var(--brown);
  }

  .match-box .match-title {
    font-weight: 800;
    font-size: 1.05rem;
    margin-bottom: 8px;
  }

  .match-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 1.05rem;
  }

  .match-emoji {
    font-size: 2rem;
  }

  .reset-btn {
    background: var(--brown);
    color: var(--white);
    border: none;
    border-radius: 999px;
    padding: 14px 32px;
    font-size: 1.15rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .reset-btn:hover {
    background: #55391a;
    transform: translateY(-2px);
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>🐾 MBTI로 포켓몬 찾기 🐾</h1>
    <p>내 성격 유형과 꼭 닮은 포켓몬을 만나보세요!</p>
  </header>

  <div class="card-panel">
    <div id="selectView">
      <p class="instruction">당신의 MBTI를 골라주세요 👇</p>
      <div class="grid" id="mbtiGrid"></div>
    </div>

    <div id="resultView" class="result hidden">
      <div class="type-tag" id="resultType"></div>
      <div class="emoji-big" id="resultEmoji"></div>
      <div class="poke-name" id="resultName"></div>
      <div class="reason-box" id="resultReason"></div>
      <div class="match-box">
        <div class="match-title">💛 찰떡궁합 유형</div>
        <div class="match-row">
          <span class="match-emoji" id="matchEmoji"></span>
          <span><b id="matchType"></b> · <span id="matchName"></span></span>
        </div>
      </div>
      <button class="reset-btn" id="resetBtn">🔄 다시 고르기</button>
    </div>
  </div>
</div>

<script>
  const DATA = {
    INTJ: { name: "뮤츠", emoji: "🔮", match: "ENFP",
      reason: "홀로 깊이 생각하며 큰 그림을 그리는 전략가예요.\n조용하지만 내면에는 강력한 힘과 확신이 가득해요.\n한번 목표를 정하면 끝까지 밀고 나가는 뚝심이 닮았어요." },
    INTP: { name: "메타몽", emoji: "🧫", match: "ENTJ",
      reason: "끝없는 호기심으로 세상의 원리를 파고드는 탐구자예요.\n상황에 따라 유연하게 생각을 바꾸는 자유로움이 있어요.\n틀에 갇히지 않는 독창적인 아이디어가 매력이에요." },
    ENTJ: { name: "리자몽", emoji: "🐉", match: "INTP",
      reason: "타고난 리더십으로 목표를 향해 거침없이 날아올라요.\n강한 카리스마와 추진력으로 주변을 이끌어요.\n도전을 두려워하지 않는 뜨거운 열정이 닮았어요." },
    ENTP: { name: "겐가", emoji: "👻", match: "INFJ",
      reason: "번뜩이는 아이디어와 재치로 사람들을 놀라게 해요.\n틀에 박힌 걸 싫어하고 새로운 시도를 즐겨요.\n장난기 넘치지만 누구보다 똑똑한 면이 닮았어요." },
    INFJ: { name: "뮤", emoji: "✨", match: "ENTP",
      reason: "신비롭고 깊은 통찰력으로 세상을 바라봐요.\n조용히 사람들의 마음을 이해하고 돌봐줘요.\n이상을 품고 묵묵히 나아가는 모습이 닮았어요." },
    INFP: { name: "이브이", emoji: "🦊", match: "ENFJ",
      reason: "무한한 가능성을 품은 따뜻한 몽상가예요.\n자신만의 가치관을 소중히 여기는 섬세한 마음을 가졌어요.\n어떤 모습으로든 성장할 수 있는 잠재력이 닮았어요." },
    ENFJ: { name: "루카리오", emoji: "🐾", match: "INFP",
      reason: "타인의 감정을 잘 읽고 따뜻하게 이끌어주는 리더예요.\n강한 카리스마로 주변 사람들에게 힘을 실어줘요.\n정의롭고 다정한 마음이 서로 닮아 있어요." },
    ENFP: { name: "피카츄", emoji: "⚡", match: "INTJ",
      reason: "밝은 에너지로 주변을 순식간에 즐겁게 만들어요.\n호기심 많고 사람들과 어울리는 걸 정말 좋아해요.\n반짝이는 매력과 따뜻한 마음씨가 닮았어요." },
    ISTJ: { name: "캥카", emoji: "🛡️", match: "ESFP",
      reason: "책임감 있고 든든하게 주변을 지켜주는 보호자예요.\n원칙을 중요하게 여기며 꾸준히 최선을 다해요.\n말없이 챙겨주는 믿음직한 모습이 닮았어요." },
    ISFJ: { name: "푸린", emoji: "🎤", match: "ESTP",
      reason: "다정한 마음으로 곁에 있는 이들을 세심하게 챙겨요.\n조용히 헌신하며 따뜻한 분위기를 만들어줘요.\n부드러운 노래처럼 편안함을 주는 존재예요." },
    ESTJ: { name: "괴력몬", emoji: "💪", match: "ISFP",
      reason: "확실한 실행력으로 일을 척척 해내는 추진력의 아이콘이에요.\n체계적이고 책임감 있게 목표를 완수해요.\n든든한 힘과 강한 의지가 닮았어요." },
    ESFJ: { name: "피피", emoji: "🌟", match: "ISTP",
      reason: "사교적이고 배려심 넘치는 분위기 메이커예요.\n주변 사람들의 행복을 진심으로 챙겨줘요.\n따뜻하고 사랑스러운 매력이 서로 닮았어요." },
    ISTP: { name: "개굴닌자", emoji: "🥷", match: "ESFJ",
      reason: "냉정하고 실용적으로 문제를 해결하는 만능 재주꾼이에요.\n말보다 행동으로 보여주는 걸 좋아해요.\n조용하지만 위기에 강한 모습이 닮았어요." },
    ISFP: { name: "잠만보", emoji: "😴", match: "ESTJ",
      reason: "자기만의 속도로 여유롭게 삶을 즐기는 자유로운 영혼이에요.\n남에게 강요하지 않고 조용히 자신의 길을 걸어요.\n느긋하지만 은은한 매력이 닮았어요." },
    ESTP: { name: "부스터", emoji: "🔥", match: "ISFJ",
      reason: "망설임 없이 행동하는 열정 넘치는 모험가예요.\n순간을 즐기며 스릴 있는 도전을 좋아해요.\n뜨거운 에너지와 대담함이 서로 닮았어요." },
    ESFP: { name: "고라파덕", emoji: "😵", match: "ISTJ",
      reason: "즉흥적이고 유쾌해서 주변을 늘 즐겁게 만들어요.\n가끔 엉뚱하지만 그 모습마저 사랑스러워요.\n밝은 에너지로 분위기를 살리는 매력이 닮았어요." }
  };

  const grid = document.getElementById('mbtiGrid');
  Object.keys(DATA).forEach(type => {
    const btn = document.createElement('button');
    btn.className = 'mbti-btn';
    btn.textContent = type;
    btn.addEventListener('click', () => showResult(type));
    grid.appendChild(btn);
  });

  const selectView = document.getElementById('selectView');
  const resultView = document.getElementById('resultView');

  function showResult(type) {
    const info = DATA[type];
    const matchInfo = DATA[info.match];

    document.getElementById('resultType').textContent = type;
    document.getElementById('resultEmoji').textContent = info.emoji;
    document.getElementById('resultName').textContent = info.name;
    document.getElementById('resultReason').innerHTML = info.reason
      .split('\n')
      .map(line => `<div>${line}</div>`)
      .join('');

    document.getElementById('matchEmoji').textContent = matchInfo.emoji;
    document.getElementById('matchType').textContent = info.match;
    document.getElementById('matchName').textContent = matchInfo.name;

    selectView.classList.add('hidden');
    resultView.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.getElementById('resetBtn').addEventListener('click', () => {
    resultView.classList.add('hidden');
    selectView.classList.remove('hidden');
  });
</script>
</body>
</html>
